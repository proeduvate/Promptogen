# PromptGen AI Service - Environment Variables
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# ── Primary Provider Selector ────────────────────────────────────────────────
# Default: gemini (Free tier supported!)
# Options: gemini | groq | openai
LLM_PROVIDER=gemini

# ── Google Gemini Configuration (Recommended & Free Tier) ────────────────────
# Get your free API key at Google AI Studio:
# 👉 https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Available Gemini Free Tier models:
# - gemini-3.5-flash-lite (Ultra fast, lightweight, recommended)
# - gemini-3.5-flash      (Balanced multimodal & reasoning)
# - gemini-3.8-flash      (Latest generation)
# - gemini-3.1-flash-lite (High throughput)
# - gemini-3.1-pro-preview (Deep reasoning)

# ── Alternative Providers (Optional) ─────────────────────────────────────────
# Groq:
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI:
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ── LLM Behavior ─────────────────────────────────────────────────────────────
LLM_TIMEOUT=30.0
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ── LangSmith Tracing (Optional) ─────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=promptogen

# ── PostgreSQL Persistence (Optional) ────────────────────────────────────────
# Set to persist prompt generation results and library data
# Example: postgresql://postgres:password@localhost:5432/promptgen
DATABASE_URL=

# ── Authentication & Google OAuth (Production) ──────────────────────────────
# Retrieve from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
JWT_SECRET_KEY=promptogen-super-secure-jwt-secret-key-32bytes-auth-2026
GUEST_DAILY_LIMIT=2

# ── Application & Server ─────────────────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
