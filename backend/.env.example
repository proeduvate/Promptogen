# ==============================================================================
# PromptGen AI Service - Environment Configuration
# Copy this file to .env and fill in your actual values:
# cp .env.example .env
# ==============================================================================

# ── 1. LLM Provider Enablement (Boolean Flags) ─────────────────────────────────
# Set to 'true' to enable a provider. When true and its token is provided below,
# the models for that provider become active and are surfaced in the UI.
ENABLE_GEMINI=true
ENABLE_GROQ=false
ENABLE_OPENAI=false
ENABLE_ANTHROPIC=false

# Default primary provider (gemini | groq | openai | anthropic)
LLM_PROVIDER=gemini

# ── 2. Provider API Keys & Model Defaults ─────────────────────────────────────

# Google Gemini (Free Tier Supported!)
# Get your free API key at Google AI Studio:
# 👉 https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (High-Speed LPU Inference)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── 3. Shared LLM Generation Settings ─────────────────────────────────────────
LLM_TIMEOUT=45.0
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ── 4. LangSmith Observability & Tracing ───────────────────────────────────────
# Enable to trace all graph workflows, LLM calls, latency, and tokens in LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=promptogen
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── 5. PostgreSQL Database Persistence ────────────────────────────────────────
# Required in production; in-memory fallback is disabled.
# Example: postgresql+asyncpg://postgres:password@localhost:5432/promptgen
DATABASE_URL=

# ── 6. Authentication & Rate Limiting ─────────────────────────────────────────
JWT_SECRET_KEY=promptogen-super-secure-jwt-secret-key-32bytes-auth-2026
JWT_EXPIRE_DAYS=30
GUEST_DAILY_LIMIT=2

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 7. Server & CORS ──────────────────────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
