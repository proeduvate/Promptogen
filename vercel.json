{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "env": {
    "UV_PYTHON": "3.12",
    "PYTHON_VERSION": "3.12",
    "PYO3_USE_ABI3_FORWARD_COMPATIBILITY": "1"
  },
  "build": {
    "env": {
      "UV_PYTHON": "3.12",
      "PYTHON_VERSION": "3.12",
      "PYO3_USE_ABI3_FORWARD_COMPATIBILITY": "1"
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
