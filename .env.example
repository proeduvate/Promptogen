# PromptGen AI Service - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Provider selector ────────────────────────────────────────────────────────
# "groq"   → use Groq (active now)
# "openai" → use OpenAI (switch here when you buy the key)
LLM_PROVIDER=groq

# ── Groq (current provider) ──────────────────────────────────────────────────
GROQ_API_KEY=gsk-...
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI (future — leave placeholder until you have a key) ─────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── LLM Behaviour (shared across both providers) ─────────────────────────────
LLM_TIMEOUT=30.0
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
